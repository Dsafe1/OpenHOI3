<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>OpenHOI3</RootNamespace>
    <Nullable>enable</Nullable>
    <!--
      The export ships its code compiled ahead, the game and the four libraries alike, so that nothing is compiled while it
      runs: a new game made and a day run took 7.4 s where it took 7.9 (2026-11-12, the savegame tool published both ways).
      Publishing alone reads it - the export's dotnet publish - and a build from the editor is as before.
    -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Godot.NET.Sdk globs every .cs file under the project directory, which would pull
      the test project's sources into the game assembly and fail the build on the
      missing xunit references - and would compile the libraries' sources a second
      time, along with the generated files under their obj folders.
    -->
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="lib/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      This project is the client: the scenes, the drawing, the input. Everything that
      can run without an engine lives in these three and is referenced, not compiled in.
    -->
    <ProjectReference Include="lib/OpenHOI3.Sim/OpenHOI3.Sim.csproj" />
    <ProjectReference Include="lib/OpenHOI3.Content/OpenHOI3.Content.csproj" />
    <ProjectReference Include="lib/OpenHOI3.Interface/OpenHOI3.Interface.csproj" />
    <ProjectReference Include="lib/OpenHOI3.Lua/OpenHOI3.Lua.csproj" />
  </ItemGroup>
</Project>
