<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The install's Lua scripts, run on the simulation: the original's interpreter, Lua 5.1.4, built
    from its source in native/lua, the classes the original hands its scripts, and the calls the
    game makes into them. See docs/mechanics/lua.md.

    The interpreter is native code, openhoi3_lua.dll. It is built here whenever it is missing or older
    than its sources, and copied beside whatever references this project.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenHOI3.Lua</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../OpenHOI3.Sim/OpenHOI3.Sim.csproj" />
    <ProjectReference Include="../OpenHOI3.Content/OpenHOI3.Content.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <LuaSourceDirectory>$(MSBuildThisFileDirectory)../../native/lua/</LuaSourceDirectory>
    <LuaBuildDirectory>$(MSBuildThisFileDirectory)obj/native/win-x64/</LuaBuildDirectory>
    <LuaLibrary>$(LuaBuildDirectory)openhoi3_lua.dll</LuaLibrary>
  </PropertyGroup>

  <ItemGroup>
    <LuaSource Include="$(LuaSourceDirectory)src/*.c;$(LuaSourceDirectory)src/*.h;$(LuaSourceDirectory)ohoi/*.c;$(LuaSourceDirectory)build.ps1" />
    <None Include="$(LuaLibrary)" Link="openhoi3_lua.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="BuildLua" BeforeTargets="BeforeBuild" Inputs="@(LuaSource)" Outputs="$(LuaLibrary)"
          Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(LuaSourceDirectory)build.ps1&quot; -OutDir &quot;$(LuaBuildDirectory)&quot;" />
  </Target>

</Project>
