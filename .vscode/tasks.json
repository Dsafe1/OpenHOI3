{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/OpenHOI3.sln"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "test",
			"type": "process",
			"command": "dotnet",
			"args": [
				"test",
				"${workspaceFolder}/tests/OpenHOI3.Tests"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": "$msCompile"
		},
		// The same three as launch.json, without the debugger. The Godot executable comes
		// from the "godotTools.editorPath.godot4" setting, as it does there.
		{
			"label": "Play OpenHOI3",
			"type": "process",
			"command": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}"
			],
			"dependsOn": "build",
			"problemMatcher": []
		},
		{
			// Optimised code, into the folder the game loads from (Directory.Build.targets).
			"label": "build (fast)",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"${workspaceFolder}/OpenHOI3.sln",
				"-p:OpenHOI3Fast=true"
			],
			"group": "build",
			"problemMatcher": "$msCompile"
		},
		{
			// Optimised and without the debugger: what full speed is to be judged by.
			"label": "Play OpenHOI3 (fast)",
			"type": "process",
			"command": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--",
				"--country=${input:country}"
			],
			"dependsOn": "build (fast)",
			"problemMatcher": []
		},
		{
			"label": "Play OpenHOI3 (headless)",
			"type": "process",
			"command": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--headless"
			],
			"dependsOn": "build",
			"problemMatcher": []
		},
		{
			"label": "Open Godot Editor",
			"type": "process",
			"command": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"-e"
			],
			"dependsOn": "build",
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "country",
			"type": "promptString",
			"description": "The tag of the country to play: GER, ENG, FRA, ITA, SOV, USA, JAP, or any other. One the game does not have plays Germany.",
			"default": "GER"
		}
	]
}
