{
	// The Godot executable is read from the "godotTools.editorPath.godot4" setting
	// provided by the Godot Tools extension. Set it per machine in .vscode/settings.json
	// (git-ignored) or in your VS Code user settings.
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Play OpenHOI3",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			// Every unit type is there to order from the start: a carrier and its air
			// groups, and the brigades a file keeps to one country.
			"name": "Play OpenHOI3 (all units)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--",
				"--all-units"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			// Asks which country to play, by its tag, and whether it may order every
			// unit type or only its own.
			"name": "Play OpenHOI3 (choose country)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--",
				"--country=${input:country}",
				"${input:units}"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			"name": "Play OpenHOI3 (headless)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--headless"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			"name": "Open Godot Editor",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"-e"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		}
	],
	"inputs": [
		{
			"id": "country",
			"type": "promptString",
			"description": "The tag of the country to play: GER, ENG, FRA, ITA, SOV, USA, JAP, or any other. One the game does not have plays Germany.",
			"default": "GER"
		},
		{
			"id": "units",
			"type": "pickString",
			"description": "Which unit types the country may order",
			"options": [
				{
					"label": "Its own: what its technology and its files allow",
					"value": "--own-units"
				},
				{
					"label": "Every unit type, from the start",
					"value": "--all-units"
				}
			],
			"default": "--own-units"
		}
	]
}
