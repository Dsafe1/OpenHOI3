{
	// The Godot executable is read from the "godotTools.editorPath.godot4" setting
	// provided by the Godot Tools extension. Set it per machine in .vscode/settings.json
	// (git-ignored) or in your VS Code user settings.
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Play OpenHOI3",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			// Asks which country to play, by its tag, and whether it may order every
			// unit type or only its own.
			"name": "Play OpenHOI3 (choose country)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--",
				"--country=${input:country}",
				"${input:units}"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			// Asks for the switches themselves, all in one box with spaces between:
			//     --country=GER --war=GER:ENG --sail=ENG:10531 --run
			// The box is handed over as one argument and the game cuts it at each " --".
			// Every switch is listed above RunDeveloperArguments in src/CSession.cs.
			"name": "Play OpenHOI3 (ask for arguments)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--",
				"${input:arguments}"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			// Optimised code and no debugger (Directory.Build.targets): about twice the speed of the
			// others at full speed. Breakpoints do nothing here.
			"name": "Play OpenHOI3 (fast)",
			"type": "coreclr",
			"request": "launch",
			"noDebug": true,
			"preLaunchTask": "build (fast)",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--",
				"--country=${input:country}"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			"name": "Play OpenHOI3 (headless)",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"--headless"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		},
		{
			"name": "Open Godot Editor",
			"type": "coreclr",
			"request": "launch",
			"preLaunchTask": "build",
			"program": "${config:godotTools.editorPath.godot4}",
			"args": [
				"--path",
				"${workspaceFolder}",
				"-e"
			],
			"cwd": "${workspaceFolder}",
			"console": "internalConsole",
			"stopAtEntry": false
		}
	],
	"inputs": [
		{
			"id": "arguments",
			"type": "promptString",
			"description": "Switches, with spaces between: --country=ENG  --all-units  --war=GER:ENG  --sail=ENG:10531  --days=7  --mode=supply  --screen=production  --centre=10531  --zoom=6  --run. Without --country=, --load= or --replay= the main menu comes up.",
			"default": "--country=GER --war=GER:ENG --sail=ENG:10531"
		},
		{
			"id": "country",
			"type": "promptString",
			"description": "The tag of the country to play: GER, ENG, FRA, ITA, SOV, USA, JAP, or any other - or nothing, for the main menu. One the game does not have plays Germany.",
			"default": ""
		},
		{
			"id": "units",
			"type": "pickString",
			"description": "Which unit types the country may order",
			"options": [
				{
					"label": "Its own: what its technology and its files allow",
					"value": "--own-units"
				},
				{
					"label": "Every unit type, from the start",
					"value": "--all-units"
				}
			],
			"default": "--own-units"
		}
	]
}
