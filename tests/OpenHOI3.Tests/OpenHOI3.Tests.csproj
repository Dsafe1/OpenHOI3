<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests run as a plain .NET project rather than inside Godot, against the three
    libraries under lib/. Neither references the engine, so nothing here does either -
    which is the point of the split: before it, sources were compiled in one by one
    and GodotSharp came along for its value types.

    The client project is deliberately not referenced. That would drag in
    Godot.NET.Sdk's build targets and the scene-bound Node classes, which do need an
    engine running.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>OpenHOI3.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../lib/OpenHOI3.Sim/OpenHOI3.Sim.csproj" />
    <ProjectReference Include="../../lib/OpenHOI3.Content/OpenHOI3.Content.csproj" />
    <ProjectReference Include="../../lib/OpenHOI3.Interface/OpenHOI3.Interface.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
